# SetuDocs AI - backend settings.
# Copy this file to .env (never commit .env) and edit the copy:
#   PowerShell / Command Prompt:  copy .env.example .env
#   macOS / Linux:                cp .env.example .env
# Every variable below is read by backend/app/core/config.py.

# --- App ---
# Name shown in the API docs and /api/health.
APP_NAME=SetuDocs AI
# "development" or "production". In production the app refuses to start while
# JWT_SECRET_KEY or any DEMO_*_PASSWORD still has its public default value.
ENV=development

# --- Database ---
# SQLite file, created in backend/ on first start. (The default file name is a
# leftover from GovDocs AI; renaming it only means starting with a fresh file.)
DATABASE_URL=sqlite:///./govdocs.db

# --- CORS ---
# Origin of the React dev server. Must match the URL `npm run dev` prints.
FRONTEND_ORIGIN=http://localhost:5173

# --- Authentication ---
# Secret that signs login tokens. Replace before any real deployment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-development-secret-before-production
# Signing algorithm for login tokens.
JWT_ALGORITHM=HS256
# How long a login stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Demo accounts (seeded on first start, never overwritten afterwards) ---
# Logins: admin, officer, citizen_demo. Change these for anything but a local demo.
DEMO_ADMIN_PASSWORD=admin123
DEMO_OFFICER_PASSWORD=officer123
DEMO_CITIZEN_PASSWORD=citizen123

# --- Document storage ---
# Folder for uploaded files, relative to backend/. Files get random server-generated names.
UPLOAD_DIR=uploads
# Largest accepted upload, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# --- OCR (Tesseract) ---
# OCR engine. "tesseract" is the supported default.
OCR_ENGINE=tesseract
# Full path to tesseract.exe if it is not on PATH (Windows), e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Tesseract language(s), "+"-joined. eng+mar needs eng.traineddata AND
# mar.traineddata in tessdata; set to "eng" if you only have English.
OCR_LANGUAGE=eng+mar
# Folder holding the .traineddata files, only if they are not in Tesseract's own tessdata folder.
# TESSDATA_PREFIX=C:\path\to\tessdata

# --- AI extraction (Google Gemini) ---
# Your key from https://aistudio.google.com/apikey. Leave empty to run without AI;
# uploads still work, AI extraction reports "not configured".
GEMINI_API_KEY=your_api_key
# Gemini model used for extraction and trust analysis. If it is retired, set another
# model your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite
# Default language of AI-written title and summary: "english" or "marathi".
# Department, category and keywords always stay English.
AI_OUTPUT_LANGUAGE=english
